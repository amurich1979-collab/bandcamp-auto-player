{
  "manifest_version": 3,
  "name": "Bandcamp Auto Player",
  "version": "1.2.0",
  "description": "Последовательно воспроизводит треки на странице Bandcamp Discover.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.bandcamp.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Bandcamp Auto Player"
  },
  "commands": {
    "toggle-autoplay": { "suggested_key": { "default": "Alt+Shift+P" }, "description": "Start or stop auto-play" },
    "previous-track": { "suggested_key": { "default": "Alt+Shift+Left" }, "description": "Play previous release" },
    "next-track": { "suggested_key": { "default": "Alt+Shift+Right" }, "description": "Skip to next release" }
  },
  "content_scripts": [
    {
      "matches": ["*://*.bandcamp.com/*"],
      "js": ["content.js"]
    }
  ]
}
