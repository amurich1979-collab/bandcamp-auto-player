{
  "manifest_version": 3,
  "name": "Bandcamp Auto Player",
  "version": "1.0.1",
  "description": "Последовательно воспроизводит треки на странице Bandcamp Discover.",
  "permissions": ["tabs", "scripting", "storage"],
  "host_permissions": ["*://*.bandcamp.com/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Bandcamp Auto Player"
  },
  "content_scripts": [
    {
      "matches": ["*://*.bandcamp.com/*"],
      "js": ["content.js", "history.js"]
    }
  ]
}
